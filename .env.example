# docker-compose.prod.yml 이 읽는다. 복사해서 .env 로 두고 값을 채운다.
# .env 는 .gitignore 에 있다. 실제 값을 커밋하지 않는다.

# DB 비밀번호
POSTGRES_PASSWORD=

# 토큰 서명 키쌍이 들어 있는 디렉터리.
# 대칭키가 아니라 키쌍인 이유: 토큰을 검증만 하면 되는 쪽(원내 게이트웨이)에
# 발급까지 가능한 키를 줄 수 없기 때문이다.
#
#   mkdir -p keys && chmod 700 keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
#   openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
#   chmod 600 keys/jwt-private.pem
#
# 저장소에 든 개발용 키를 그대로 쓰면 prod 프로파일에서 기동이 막힌다.
JWT_KEYS_DIR=./keys

# ── 공개 배포용 ────────────────────────────────────────────
# 도메인을 넣으면 Caddy 가 인증서를 받아 HTTPS 로 뜬다.
# 넣기 전에 그 도메인의 A 레코드가 이 서버를 가리키고 있어야 한다.
#   SITE_ADDRESS=nurse-collab.example.com
#
# 비워 두면 :80 평문으로 뜬다. 로컬 확인용이다.
# 폰 브라우저는 http 페이지에서 wss 를 막으므로, 평문으로 공개하면
# 실시간 갱신이 조용히 죽는다.
SITE_ADDRESS=

# 인증서 만료 안내를 받을 주소
ACME_EMAIL=

# 호스트에서 열 포트. 인증서 발급(HTTP-01)이 80 으로 들어오므로 그대로 두는 편이 낫다.
WEB_PORT=80
WEB_TLS_PORT=443

# JVM 이 서버 램의 몇 %까지 힙으로 쓸지. 한 대에 DB·Redis 가 같이 돈다.
#   2GB 서버 → 40   4GB 서버 → 50~60
JVM_HEAP_PERCENT=50

# 데모 데이터를 매일 되돌릴 시각 (24시간, 서버 시각 기준 Asia/Seoul).
# 공개해 두면 누구나 로그인해 데이터를 바꾸므로 하루 한 번 처음 상태로 돌린다.
DEMO_RESET_AT=04:00
