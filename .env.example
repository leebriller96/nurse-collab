# docker-compose.prod.yml 이 읽는다. 복사해서 .env 로 두고 값을 채운다.
# .env 는 .gitignore 에 있다. 실제 값을 커밋하지 않는다.

# DB 비밀번호
POSTGRES_PASSWORD=

# 원내 DB 비밀번호. 원내 서버를 따로 띄우는 구성(docker-compose.split.yml)에서만 쓴다.
# 업무 DB 와 다른 값을 넣는다. 하나가 새도 다른 쪽이 열리지 않게.
PHI_POSTGRES_PASSWORD=

# 원내 경로(/api/v1/phi)를 받을 대역. 원내 서버를 따로 띄우는 구성에서만 쓴다.
# 비워 두면 사설망 전부(10/8, 172.16/12, 192.168/16, 루프백)만 받는다.
# 이 밖에서 온 원내 요청은 중계 서버가 연결을 끊고, 화면에는 "원내망에서만 조회됩니다" 가 뜬다.
# 공개 서버에서 내 폰으로 이름까지 보고 싶으면 내 공인 IP 를 더한다. 예) PHI_ALLOWED_NETS=203.0.113.7/32
PHI_ALLOWED_NETS=

# 토큰 서명 키쌍이 들어 있는 디렉터리.
# 대칭키가 아니라 키쌍인 이유: 토큰을 검증만 하면 되는 쪽(원내 게이트웨이)에
# 발급까지 가능한 키를 줄 수 없기 때문이다.
#
#   mkdir -p keys && chmod 700 keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
#   openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
#   chmod 600 keys/jwt-private.pem
#   sudo chown -R 10001:10001 keys      # 컨테이너가 도는 uid
#
# 마지막 줄을 빠뜨리면 "Permission denied" 로 기동이 막힌다.
# 바인드 마운트는 호스트의 소유자를 그대로 들고 가기 때문이다.
#
# 저장소에 든 개발용 키를 그대로 쓰면 prod 프로파일에서 기동이 막힌다.
JWT_KEYS_DIR=./keys

# ── 공개 배포용 ────────────────────────────────────────────
# 도메인을 넣으면 Caddy 가 인증서를 받아 HTTPS 로 뜬다.
# 넣기 전에 그 도메인의 A 레코드가 이 서버를 가리키고 있어야 한다.
#   SITE_ADDRESS=nurse-collab.example.com
#
# 비워 두면 :80 평문으로 뜬다. 로컬 확인용이다.
# 폰 브라우저는 http 페이지에서 wss 를 막으므로, 평문으로 공개하면
# 실시간 갱신이 조용히 죽는다.
SITE_ADDRESS=

# 인증서 만료 안내를 받을 주소
ACME_EMAIL=

# 호스트에서 열 포트. 인증서 발급(HTTP-01)이 80 으로 들어오므로 그대로 두는 편이 낫다.
WEB_PORT=80
WEB_TLS_PORT=443

# JVM 이 서버 램의 몇 %까지 힙으로 쓸지. 한 대에 DB·Redis 가 같이 돈다.
#   2GB 서버 → 40   4GB 서버 → 50~60
JVM_HEAP_PERCENT=50

# 데모 데이터를 매일 되돌릴 시각 (24시간, 서버 시각 기준 Asia/Seoul).
# 공개해 두면 누구나 로그인해 데이터를 바꾸므로 하루 한 번 처음 상태로 돌린다.
DEMO_RESET_AT=04:00

# 되돌릴 데이터. 비우면 시연용 요청 20건, hospital 이면 작은 병원 반년치(요청 10만 건).
# 반년치는 DB 가 200MB 남짓 되고 초기화 동안 1분 정도 DB 가 바쁘다.
DEMO_SEED_PROFILE=

# 폰 알림(Web Push) 키. 비우면 폰 알림만 꺼지고 나머지는 그대로 돈다.
# 만드는 법은 docs/05-deployment.md 4-2. 키를 바꾸면 간호사마다 "알림 받기" 를 다시 눌러야 한다.
VAPID_PRIVATE_KEY_FILE=
VAPID_PUBLIC_KEY_FILE=
VAPID_SUBJECT=mailto:내이메일@example.com
