# 한 오리진에서 화면과 API 를 같이 내보낸다.
# 개발 때 Vite 프록시가 하던 일과 모양을 맞춘 것이라, 프론트 코드에 서버 주소가 없다.

{
	# 인증서 만료 안내를 받을 주소. ACME 가 실제로 도는 배포에서만 의미가 있다.
	email {$ACME_EMAIL:admin@localhost}
}

# 도메인을 주면 Caddy 가 인증서를 알아서 받고 갱신한다.
# 값이 없으면 :80 평문으로 뜬다. 로컬에는 도메인이 없어 인증서를 받을 수 없기 때문이다.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		# 이 앱은 자기 번들만 쓴다. 외부에서 스크립트도 폰트도 끌어오지 않으므로
		# 전부 'self' 로 닫는다. 환자 정보를 다루는 화면에 남의 코드가 끼어들 길을 막는 것이다.
		# connect-src 'self' 는 같은 오리진의 ws/wss 도 포함한다(CSP 3).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"

		# 확장자와 다른 내용을 브라우저가 알아서 해석하지 않게 한다
		X-Content-Type-Options nosniff
		# 다른 사이트로 나갈 때 환자 id 가 든 경로를 넘기지 않는다
		Referrer-Policy strict-origin-when-cross-origin
		# 쓰지 않는 기기 권한은 아예 닫는다
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 서버 종류를 굳이 알릴 필요가 없다
		-Server
	}

	# 환자 정보는 원내 서버로 보낸다. 원내 것은 전부 경로가 /api/v1/phi 로 시작하므로 이 한 줄이면 된다.
	# 한 서버 구성에서는 PHI_UPSTREAM 이 비어 있어 백엔드가 둘 다 받는다.
	# 경로가 더 구체적이라 Caddy 가 아래 /api/* 보다 이것을 먼저 고른다.
	handle /api/v1/phi/* {
		reverse_proxy {$PHI_UPSTREAM:backend:8080}
	}

	# reverse_proxy 는 X-Forwarded-For / -Proto 를 알아서 붙인다.
	# 이 헤더가 없으면 감사 로그의 접속 IP 가 전부 이 컨테이너 주소로 남는다.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# STOMP 핸드셰이크. reverse_proxy 가 Upgrade 를 그대로 넘기므로 별도 설정이 없다.
	handle /ws* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# 파일명에 해시가 붙어 있어 오래 캐시해도 안전하다
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# 주소창에 직접 친 /ward/board 같은 경로도 index.html 이 받아야 한다
		try_files {path} /index.html
		file_server
	}
}
