# 한 오리진에서 화면과 API 를 같이 내보낸다.
# 개발 때 Vite 프록시가 하던 일과 모양을 맞춘 것이라, 프론트 코드에 서버 주소가 없다.

{
	# 인증서 만료 안내를 받을 주소. ACME 가 실제로 도는 배포에서만 의미가 있다.
	email {$ACME_EMAIL:admin@localhost}
}

# 도메인을 주면 Caddy 가 인증서를 알아서 받고 갱신한다.
# 값이 없으면 :80 평문으로 뜬다. 로컬에는 도메인이 없어 인증서를 받을 수 없기 때문이다.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# reverse_proxy 는 X-Forwarded-For / -Proto 를 알아서 붙인다.
	# 이 헤더가 없으면 감사 로그의 접속 IP 가 전부 이 컨테이너 주소로 남는다.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# STOMP 핸드셰이크. reverse_proxy 가 Upgrade 를 그대로 넘기므로 별도 설정이 없다.
	handle /ws* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# 파일명에 해시가 붙어 있어 오래 캐시해도 안전하다
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# 주소창에 직접 친 /ward/board 같은 경로도 index.html 이 받아야 한다
		try_files {path} /index.html
		file_server
	}
}
